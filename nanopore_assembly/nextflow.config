// ============================================================================
// Dana Nanopore Assembly Pipeline - Nextflow Configuration
// ============================================================================

// Default parameters (override via CLI: --param_name value)
params {
    // Help
    help            = false

    // Required
    input           = null      // Directory containing *.fastq.gz reads

    // Output
    outdir          = "results"
    store_dir       = null      // Persistent cache dir (opt-in): assembly outputs only
    publish_concat  = false     // Publish per-barcode concatenated reads (duplicates the input)

    // Assembly
    assembler       = 'flye'        // Assembler: 'flye', 'metamdbg', 'myloasm'
    // Flye read mode: 'nano-raw', 'nano-hq' or 'nano-corr'. Required, no default.
    // It picks Flye's index (nano-hq uses minimizers, nano-raw counts every
    // k-mer), overlap settings and error model, so it has to be a decision made
    // in the launch script. 'auto' is still accepted if asked for explicitly,
    // but it guesses from the first 10,000 reads of the stream: on 2026-09-23 it
    // chose nano-hq for the whole marine co-assembly because the first file was
    // a 2025 R10 SUP barcode, where every earlier marine run had got nano-raw.
    read_type       = null
    // With --read_type nano-hq, drop reads above Flye's nano-hq envelope (mean
    // error over 5%) before assembly. false keeps them; either way the share of
    // bases outside the envelope is measured, and a warning goes to the main
    // Nextflow log if it exceeds nano_hq_warn_pct -- the data saying nano-raw
    // may be the better mode.
    nano_hq_filter   = true
    nano_hq_warn_pct = 10
    min_overlap     = 1000          // Flye --min-overlap
    polish          = null          // Run Flye polisher; null = auto (true for flye, false for others)
    min_barcode_size = 10485760     // Skip barcodes with < 10 MB of reads
    run_remove_human = true         // Remove human reads (minimap2 vs human ref)
    human_ref       = "${projectDir}/../../databases/human_ref/GRCh38_noalt_as.fa.gz"
    dedupe          = true          // BBDuk deduplication before assembly
    // Emit read_id -> sample (read_map.tsv.gz) from PREPARE_READS, keyed on the
    // staged filename so it matches meta.id exactly. Lets a pooled BAM be split
    // per sample downstream. Superset of the assembled reads: written before
    // fastq_filter drops anything.
    emit_read_map   = false
    dedupe_memory    = '24 GB'
    dedupe_memory_gb = 24
    filtlong_size   = null          // Filtlong -t (e.g. "40000000000"); null = skip
    // fastq_filter picks the best filtlong_size bases with an order-independent
    // two-pass bucket sort. Set true for the legacy single-pass streaming
    // threshold, which needs no spill space but keeps a different, position-
    // biased subset on every run.
    onepass_filter  = false
    // Skip read preparation and assembly; map every sample against the existing
    // <store_dir or outdir>/assembly/assembly.fasta and rebuild depths. BAMs
    // already in the store are kept, so only missing samples are mapped.
    map_only        = false

    // Resources (defaults; override with profiles)
    assembly_cpus   = 16
    assembly_memory = '60 GB'
}

// ============================================================================
// Executor
// ============================================================================

// Memory the local executor may hand out: the job's allocation, not the node's.
// /proc/meminfo reports the whole machine even inside a Slurm job or container,
// so a 750 GB job on a 755 GB fir node, or a 1200 GB job on a 1.5 TB grex node,
// was scheduled as if it owned all of it. Tasks packed to that ceiling OOM-killed
// each other (115 MAP_READS kills on the freshwater metaMDBG run, 41 samples lost).
// Take the smallest of MemTotal, Slurm's allocation and the cgroup limit, and
// hold 5% back for Nextflow itself, the container runtime and page cache.
def _allocMem = {
    def limits = []
    try {
        def kb = new File('/proc/meminfo').readLines()
            .find { it.startsWith('MemTotal:') }?.split()?.getAt(1)?.toLong()
        if (kb) limits << kb * 1024L
    } catch (e) { }
    try {
        def env = System.getenv()
        if (env.SLURM_MEM_PER_NODE?.isLong())
            limits << env.SLURM_MEM_PER_NODE.toLong() * 1024L * 1024L
        else if (env.SLURM_MEM_PER_CPU?.isLong() && env.SLURM_CPUS_ON_NODE?.isLong())
            limits << env.SLURM_MEM_PER_CPU.toLong() * env.SLURM_CPUS_ON_NODE.toLong() * 1024L * 1024L
    } catch (e) { }
    try {
        // cgroup v2 ("0::/path") or v1 memory controller ("N:memory:/path").
        // Walk up the hierarchy: the Slurm limit may sit on a parent cgroup.
        new File('/proc/self/cgroup').readLines().each { line ->
            def f = line.split(':', 3)
            if (f.size() < 3) return
            def v2 = f[1] == ''
            if (!v2 && !f[1].split(',').contains('memory')) return
            def base = v2 ? '/sys/fs/cgroup' : '/sys/fs/cgroup/memory'
            def leaf = v2 ? 'memory.max' : 'memory.limit_in_bytes'
            def p = f[2]
            while (true) {
                def lf = new File("${base}${p == '/' ? '' : p}/${leaf}")
                if (lf.canRead()) {
                    def v = lf.text.trim()
                    // v1 reports "no limit" as a huge page-rounded number
                    if (v.isLong() && v.toLong() < (1L << 60)) limits << v.toLong()
                }
                if (p == '/' || !p) break
                p = p.substring(0, p.lastIndexOf('/')) ?: '/'
            }
        }
    } catch (e) { }
    if (!limits) return 8.GB
    return ((limits.min() * 0.95d) as long) as nextflow.util.MemoryUnit
}()

executor {
    $local {
        cpus   = Runtime.getRuntime().availableProcessors()
        memory = _allocMem
    }
}

// ============================================================================
// Conda configuration
// ============================================================================

conda {
    enabled    = true
    cacheDir   = "${projectDir}/conda-envs"
    useMamba   = true
    createTimeout = '60 min'
}

// ============================================================================
// Process resource labels
// ============================================================================

process {

    beforeScript = { def d = params.store_dir ?: params.outdir; "mkdir -p '${d}/pipeline_info' && echo '${task.process}\tSTART\t'\$(date -Iseconds) >> '${d}/pipeline_info/pipeline_timing.tsv'" }
    afterScript  = { def d = params.store_dir ?: params.outdir; "echo '${task.process}\tEND\t'\$(date -Iseconds)'\t'\${nxf_main_ret:-0} >> '${d}/pipeline_info/pipeline_timing.tsv'" }

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 16.GB
    }
    withLabel: 'process_high' {
        cpus   = { params.assembly_cpus }
        memory = { params.assembly_memory }
    }

    // 'ignore', not 'terminate', is deliberate while the pipeline is under
    // development: a failing task must not bring the Nextflow process down,
    // because that releases the node and takes the node-local work directory
    // with it -- and that temp state is usually the only way to work out what
    // crashed. Failures are meant to be loud, not fatal, so stages that can
    // fail quietly carry their own warnings (see PREPARE_READS). Revisit this
    // before the pipeline is treated as production.
    errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    maxRetries    = 1
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    standard {
        process.executor = 'local'
    }

    test {
        params {
            outdir        = "test_results"
            min_overlap   = 1000
            assembly_cpus   = 4
            assembly_memory = '8 GB'
        }
        process {
            withLabel: 'process_high' {
                cpus   = 4
                memory = 8.GB
                time   = 2.h
            }
        }
    }

}

// ============================================================================
// Reports and tracing
// ============================================================================

timeline {
    enabled   = true
    file      = "${params.store_dir ? params.store_dir : params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.store_dir ? params.store_dir : params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.store_dir ? params.store_dir : params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

dag {
    enabled   = true
    file      = "${params.store_dir ? params.store_dir : params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'dana-nanopore-assembly'
    author          = 'Dana Pipeline'
    description     = 'Nanopore assembly pipeline: preprocessing, co-assembly, mapping, depth calculation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
