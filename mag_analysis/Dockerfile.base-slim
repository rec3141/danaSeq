# ============================================================================
# Dana MAG Assembly Pipeline - Slim Base Image
# ============================================================================
#
# Merged conda environments (9 envs instead of 35).
# See envs/MERGE_PLAN.md for rationale and dry-run test results.
#
# Build:
#   docker build -f Dockerfile.base-slim -t danaseq-mag-base-slim .
#   docker build -f Dockerfile.base-slim --build-arg TORCH_VARIANT=cuda \
#       -t danaseq-mag-base-slim-gpu .
#
# TORCH_VARIANT picks the PyTorch build in the envs whose tools can train on a
# GPU: binning (SemiBin2, LorBin), vamb and comebin. cuda adds ~4 GB per env.
#
# ============================================================================

FROM condaforge/miniforge3:latest

ARG TORCH_VARIANT=cpu
LABEL danaseq.torch.variant="${TORCH_VARIANT}"

LABEL maintainer="rec3141@gmail.com"
LABEL description="Dana MAG Assembly Pipeline - Slim base image (9 merged conda envs)"
LABEL org.opencontainers.image.source="https://github.com/rec3141/danaSeq"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        procps \
        curl \
        git \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Install merged conda environments
# ============================================================================

COPY envs/merged/ /tmp/envs/
COPY envs/whokaryote.yml /tmp/envs/whokaryote.yml
COPY envs/vamb.yml envs/comebin.yml /tmp/envs/
COPY docker/torch_variant.sh /tmp/torch_variant.sh
RUN sh /tmp/torch_variant.sh "$TORCH_VARIANT" \
    /tmp/envs/binning.yml /tmp/envs/vamb.yml /tmp/envs/comebin.yml

# Pre-create CheckM v1 data sentinel (comebin/drep pull checkm-genome transitively)
RUN mkdir -p /opt/checkm_data_stub/genome_tree \
    && touch /opt/checkm_data_stub/genome_tree/genome_tree.derep.txt
ENV CHECKM_DATA_DIR=/opt/checkm_data_stub

# 1. Assembly: flye, minimap2, samtools, coverm, bbmap, metamdbg, myloasm
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-assembly  -f /tmp/envs/assembly.yml

# 2. The PyTorch envs: binning (metabat2, maxbin2, das_tool, SemiBin2,
# LorBin), vamb and comebin. Built in one step from a package cache on the
# image's own filesystem, not a cache mount, so conda hardlinks their shared
# files (the CUDA libraries above all) instead of copying them into each env:
# the cuda variant's three envs take 16 GB this way against 35 GB copied.
# The solver cannot see a GPU during the build; CONDA_OVERRIDE_CUDA stands in
# for the host driver so CUDA builds resolve. It is set here only, so no other
# env picks up CUDA packages.
RUN if [ "$TORCH_VARIANT" = cuda ]; then export CONDA_OVERRIDE_CUDA=12.9; fi \
    && for e in binning vamb comebin; do \
        mamba env create -y -p /opt/conda/envs/dana-mag-$e -f /tmp/envs/$e.yml || exit 1; \
    done \
    && mamba clean -afy
RUN /opt/conda/envs/dana-mag-binning/bin/pip install --no-deps \
    'lorbin @ git+https://github.com/rec3141/LorBin.git' hnswlib

# 3. Quality: genomad, checkm2, checkv, whokaryote+tiara (pip)
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-quality   -f /tmp/envs/quality.yml
RUN /opt/conda/envs/dana-mag-quality/bin/pip install --no-deps \
    'whokaryote @ git+https://github.com/rec3141/whokaryote.git@fix/gff-attribute-parsing' tiara && \
    /opt/conda/envs/dana-mag-quality/bin/pip install 'setuptools<81'

# 3b. Whokaryote standalone (needs sklearn 1.0.x for bundled model compatibility)
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-whokaryote -f /tmp/envs/whokaryote.yml
RUN /opt/conda/envs/dana-mag-whokaryote/bin/pip install --force-reinstall --no-deps \
    'whokaryote @ git+https://github.com/rec3141/whokaryote.git@fix/gff-attribute-parsing'

# 4. Annotate: bakta, emapper, diamond
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-annotate  -f /tmp/envs/annotate.yml

# 5. Classify: kaiju, kraken2, barrnap, vsearch, kofamscan, metaeuk
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-classify  -f /tmp/envs/classify.yml

# 6. Genomic: defensefinder, macsyfinder, integron_finder, dbcan
# MacSyFinder stays at 2.1.4: defense-finder 3.0.0 requires exactly that, and
# 2.1.5+ moved its library from macsypy to macsylib, which defense-finder
# cannot import (every run then reports 0 defense systems).
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-genomic   -f /tmp/envs/genomic.yml && \
    /opt/conda/envs/dana-mag-genomic/bin/pip install --upgrade integron_finder 'macsyfinder==2.1.4' && \
    /opt/conda/envs/dana-mag-genomic/bin/python -c "import macsypy, defense_finder"

# 7. Derep: galah, skani, sourmash, skder, drep
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-derep     -f /tmp/envs/derep.yml

# 8. Strain: strainy, instrain (pip), floria
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-strain    -f /tmp/envs/strain.yml
RUN /opt/conda/envs/dana-mag-strain/bin/pip install --no-deps \
    'instrain @ git+https://github.com/rec3141/inStrain.git@fix-biopython-compat'

# 9. PathViz: pathway tools, viz, nodejs
RUN --mount=type=cache,target=/opt/conda/pkgs \
    mamba env create -y -p /opt/conda/envs/dana-mag-pathviz   -f /tmp/envs/pathviz.yml
RUN /opt/conda/envs/dana-mag-pathviz/bin/pip install --no-deps KEGGDecoder && \
    git clone --depth 1 https://github.com/mgtools/MinPath.git \
        /opt/conda/envs/dana-mag-pathviz/share/minpath && \
    chmod +x /opt/conda/envs/dana-mag-pathviz/share/minpath/MinPath.py

# 10. Standalone envs the merged ones do not cover. Their modules name their
# own conda env (dana-mag-vamb etc.), and a container run ignores conda, so
# each needs its env and a dana-tools wrapper here (vamb and comebin are built
# with the PyTorch envs in step 2). COMEBin comes from the bioconda package,
# which pins its full dependency set (checkm-genome, biolib, atomicwrites,
# tensorboard, ...). GTDB-Tk is 2.4.1, the first release that reads r226.
COPY envs/binette.yml envs/gtdbtk.yml /tmp/envs-standalone/
RUN --mount=type=cache,target=/opt/conda/pkgs \
    for e in binette gtdbtk; do \
        mamba env create -y -p /opt/conda/envs/dana-mag-$e -f /tmp/envs-standalone/$e.yml || exit 1; \
    done \
    && test -x /opt/conda/envs/dana-mag-vamb/bin/vamb \
    && test -x /opt/conda/envs/dana-mag-binette/bin/binette \
    && test -x /opt/conda/envs/dana-mag-gtdbtk/bin/gtdbtk \
    && test -x /opt/conda/envs/dana-mag-comebin/bin/run_comebin.sh \
    && rm -rf /tmp/envs-standalone

# Each PyTorch env must carry the build this variant promises: a CUDA image
# whose torch fell back to CPU would silently train on CPU everywhere.
RUN for e in binning vamb comebin; do \
        built=$(/opt/conda/envs/dana-mag-$e/bin/python -c 'import torch; print(torch.version.cuda or "cpu")') || exit 1; \
        echo "dana-mag-$e: torch cuda=$built"; \
        case "$TORCH_VARIANT:$built" in cpu:cpu|cuda:12.*) ;; *) exit 1 ;; esac; \
    done

# Point every CheckM v1 install at /data/db/checkm_data, where
# run-mag-analysis.sh mounts <db_dir>/checkm_data. COMEBin's final bin
# selection runs `checkm analyze`/`qa` with CheckM 1.1.3, which ignores
# CHECKM_DATA_PATH and reads only DATA_CONFIG. On import CheckM also tries to
# rewrite DATA_CONFIG if the data folder lacks a .dmanifest, which crashes in
# the read-only container, so a placeholder .dmanifest stays in the image for
# runs without the database mounted. The build fails only if COMEBin's CheckM
# cannot import.
RUN rm -rf /opt/checkm_data_stub \
    && mkdir -p /data/db/checkm_data && touch /data/db/checkm_data/.dmanifest \
    && for cfg in /opt/conda/envs/*/lib/python3*/site-packages/checkm/DATA_CONFIG; do \
        [ -e "$cfg" ] || continue; \
        /opt/conda/bin/python -c 'import json,sys; p=sys.argv[1]; c=json.load(open(p)); c["dataRoot"]="/data/db/checkm_data"; open(p,"w").write(json.dumps(c))' "$cfg"; \
        env_py="${cfg%%/lib/python3*}/bin/python"; \
        if out=$("$env_py" -c 'from checkm.defaultValues import DefaultValues' 2>&1) \
            && case "$out" in *setRoot*|*"data folder"*) false ;; esac; then continue; fi; \
        echo "[WARNING] CheckM import in ${cfg%%/lib/python3*}: $out"; \
        case "$cfg" in */dana-mag-comebin/*) exit 1 ;; esac; \
    done
ENV CHECKM_DATA_DIR=

# ============================================================================
# Strip packaging cruft (~500+ MB savings)
# ============================================================================

RUN find /opt/conda/envs -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; \
    rm -rf /opt/conda/envs/*/share/{locale,doc,info,man,cups,icons,gir-1.0,easel} \
           /opt/conda/envs/*/lib/python*/site-packages/pip ; \
    find /opt/conda/envs -name "*.pyc" -delete 2>/dev/null; \
    rm -rf /tmp/envs/ ; \
    true
# NOTE: setuptools is NOT stripped — tiara imports pkg_resources, and
# setuptools>=60 provides a distutils shim needed by integron_finder on Python 3.13

# ============================================================================
# Create wrapper scripts so tools are callable from PATH
# ============================================================================

RUN mkdir -p /usr/local/bin/dana-tools \
    # --- assembly env ---
    && for tool in flye filtlong nextflow java minimap2 samtools coverm \
                   bbduk.sh bbmap.sh dedupe.sh reformat.sh statswrapper.sh \
                   metaMDBG myloasm pigz; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-assembly/bin:$PATH\nexec /opt/conda/envs/dana-mag-assembly/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- binning env ---
    && for tool in metabat2 run_MaxBin.pl DAS_Tool jgi_summarize_bam_contig_depths \
                   SemiBin2 LorBin; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-binning/bin:$PATH\nexec /opt/conda/envs/dana-mag-binning/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- quality env ---
    && for tool in genomad checkm2 checkv tiara prodigal; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-quality/bin:$PATH\nexec /opt/conda/envs/dana-mag-quality/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- whokaryote standalone env (sklearn 1.0.x for model compat) ---
    && for tool in whokaryote.py; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-whokaryote/bin:$PATH\nexec /opt/conda/envs/dana-mag-whokaryote/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- annotate env ---
    && for tool in bakta bakta_db emapper.py download_eggnog_data.py diamond; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-annotate/bin:$PATH\nexec /opt/conda/envs/dana-mag-annotate/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- classify env ---
    && for tool in kaiju kaiju-addTaxonNames kaiju2table kaiju-makedb \
                   kraken2 barrnap vsearch aragorn \
                   exec_annotation hmmpress metaeuk; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-classify/bin:$PATH\nexec /opt/conda/envs/dana-mag-classify/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- genomic env ---
    && for tool in defense-finder macsyfinder macsydata msf_data \
                   integron_finder run_dbcan dbcan_build hmmscan hmmsearch; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-genomic/bin:$PATH\nexec /opt/conda/envs/dana-mag-genomic/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- derep env ---
    && for tool in galah skani sourmash skder dRep; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-derep/bin:$PATH\nexec /opt/conda/envs/dana-mag-derep/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- strain env ---
    && for tool in strainy floria inStrain; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-strain/bin:$PATH\nexec /opt/conda/envs/dana-mag-strain/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- pathviz env ---
    && for tool in KEGG-decoder node npm python3 Rscript; do \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-pathviz/bin:$PATH\nexec /opt/conda/envs/dana-mag-pathviz/bin/%s "$@"\n' "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done \
    # --- standalone envs: env:tool ---
    && for pair in vamb:vamb binette:binette gtdbtk:gtdbtk comebin:gen_cov_file.sh; do \
        env="${pair%%:*}"; tool="${pair#*:}"; \
        printf '#!/bin/sh\nexport PATH=/opt/conda/envs/dana-mag-%s/bin:$PATH\nexec /opt/conda/envs/dana-mag-%s/bin/%s "$@"\n' "$env" "$env" "$tool" \
            > "/usr/local/bin/dana-tools/$tool" \
        && chmod +x "/usr/local/bin/dana-tools/$tool"; \
    done

# COMEBin resolves -a with realpath and writes beside the resolved assembly,
# a read-only mount in a pipeline run; this wrapper copies it in first.
COPY docker/run_comebin.sh /usr/local/bin/dana-tools/run_comebin.sh

ENV PATH="/usr/local/bin/dana-tools:${PATH}"

# ============================================================================
# Writable home for non-root users
# ============================================================================

RUN mkdir -p /home/dana && chmod 777 /home/dana
ENV HOME=/home/dana
