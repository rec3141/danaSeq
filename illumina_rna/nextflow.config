// ============================================================================
// Illumina RNA Pipeline - Nextflow Configuration
// ============================================================================

workDir = "${projectDir}/work"

params {
    // Help
    help            = false

    // Reads (one of)
    input           = null              // Directory searched recursively for paired reads
    samplesheet     = null              // CSV: sample,r1,r2

    // References (one of)
    references      = null              // Directory of <name>.fasta (+ <name>.gff, <name>.bins.tsv)
    from_mag        = null              // mag_analysis outdir
    from_assembly   = null              // nanopore_assembly / illumina_assembly outdir
    ref_name        = null              // Name for a --from_mag/--from_assembly reference
    bin_set         = 'dastool'         // mag_analysis bin set for per-MAG tables
    contig_explorer = null              // contig t-SNE dir (mag_analysis viz format); default <from_mag>/viz/data

    // Output
    outdir          = "results"
    store_dir       = null

    // Batching
    max_read_pairs  = 0                 // >0: use only the first N pairs per sample
    chunk           = null              // 'I/N': process only that chunk of the sorted samples
    summarize       = true
    prepare_only    = false

    // QC
    min_readlen     = 50                // RNA-seq reads can be shorter than DNA; 50 is a safer default
    run_filterbytile = false            // Illumina tiles only; BGI/MGI headers have none
    run_remove_human = true
    human_ref       = "${projectDir}/../../databases/human_ref"
    run_fastqc      = false

    // rRNA removal
    rrna_method     = 'bbduk'           // bbduk | sortmerna | none
    rrna_refs       = null              // rRNA FASTA or dir of FASTAs (e.g. SILVA SSU+LSU NR99)

    // Mapping
    mapper          = 'strobealign'     // strobealign | bbmap
    read_len        = 150               // strobealign index is tuned to the read length
    min_identity    = 90                // bbmap minid; metatranscriptomic mismatches usually <10%

    // Quantification
    strandedness    = 'unstranded'      // 'unstranded' | 'forward' | 'reverse'
    feature_types   = 'CDS,rRNA,tRNA,tmRNA,ncRNA'
    attr_type       = 'locus_tag'       // GFF attribute naming a gene (falls back to ID)
    min_mapq        = 0

    // Viz
    viz_title       = null              // Shown in the viz header
    viz_mag_url     = null              // mag_analysis viz of the same reference (bins link there)
    viz_top_genes   = 2000
    viz_top_functions = 500

    // Resources
    rna_cpus        = 16
    rna_memory      = '64 GB'
    map_cpus        = null              // default: rna_cpus
    map_memory      = null              // default: rna_memory

    // SLURM
    slurm_account   = null      // no default: required with -profile slurm
    conda_path      = null
}

// ============================================================================
// Conda configuration
// ============================================================================

conda {
    enabled    = true
    cacheDir   = "${projectDir}/conda-envs"
    useMamba   = true
    createTimeout = '60 min'
}

// ============================================================================
// Local executor limits
// ============================================================================
// Inside a SLURM allocation the local executor would otherwise size itself to
// the whole node; cap it at what the job was given.

executor {
    $local {
        cpus   = System.getenv('SLURM_CPUS_PER_TASK') ? System.getenv('SLURM_CPUS_PER_TASK') as int : Runtime.runtime.availableProcessors()
        if (System.getenv('SLURM_MEM_PER_NODE')) {
            memory = "${(System.getenv('SLURM_MEM_PER_NODE') as long) * 95 / 100} MB"
        }
    }
}

// ============================================================================
// Process resource labels
// ============================================================================

process {

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 24.GB
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = { [params.rna_cpus as int, Runtime.runtime.availableProcessors()].min() }
        memory = { "${params.rna_memory}" as nextflow.util.MemoryUnit }
        time   = 24.h
    }
    withLabel: 'process_map' {
        cpus   = { [(params.map_cpus ?: params.rna_cpus) as int, Runtime.runtime.availableProcessors()].min() }
        memory = { "${params.map_memory ?: params.rna_memory}" as nextflow.util.MemoryUnit }
        time   = 24.h
    }

    // In the container the tools live in per-stage envs under /opt/conda/envs;
    // put the right one first on PATH. (With conda, the conda directive does it.)
    withLabel: 'env_rnaseq' {
        beforeScript = 'if [ -d /opt/conda/envs/dana-illumina-rna-rnaseq/bin ]; then export PATH=/opt/conda/envs/dana-illumina-rna-rnaseq/bin:$PATH; fi'
    }
    withLabel: 'env_align' {
        beforeScript = 'if [ -d /opt/conda/envs/dana-mag-assembly/bin ]; then export PATH=/opt/conda/envs/dana-mag-assembly/bin:$PATH; fi'
    }

    errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    maxRetries    = 1
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    standard {
        process.executor = 'local'
    }

    test {
        params {
            outdir          = "test_results"
            rna_cpus        = 4
            rna_memory      = '8 GB'
        }
        process {
            withLabel: 'process_high' {
                cpus   = 4
                memory = 8.GB
                time   = 2.h
            }
        }
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'default'
        process.clusterOptions = "--account=${params.slurm_account}"
        process.beforeScript = params.conda_path ? "export PATH=${params.conda_path}:\$PATH" : ''

        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
            withLabel: 'process_medium' {
                cpus   = 8
                memory = 24.GB
                time   = 4.h
            }
            withLabel: 'process_high' {
                cpus   = { params.rna_cpus as int }
                memory = { "${params.rna_memory}" as nextflow.util.MemoryUnit }
                time   = 24.h
            }
            withLabel: 'process_map' {
                cpus   = { (params.map_cpus ?: params.rna_cpus) as int }
                memory = { "${params.map_memory ?: params.rna_memory}" as nextflow.util.MemoryUnit }
                time   = 24.h
            }
        }
    }
}

// ============================================================================
// Reports and tracing
// ============================================================================

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true
           fields  = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss' }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'dana-illumina-rna'
    author          = 'Dana Pipeline'
    description     = 'Illumina RNA-seq pipeline (BBTools QC + rRNA split + strobealign/BBmap to references + featureCounts)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
